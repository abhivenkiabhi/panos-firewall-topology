# ====================================================================
# Palo Alto Networks PAN-OS 11.1 Running Configuration
# Device: PA-3410 (Hostname: PA-NGFW-CORE-01)
# Serial: 001801000001
# Generated via: set cli config-output-format set ; show config running
# Snapshot: Revision V1 (Baseline Production)
# ====================================================================

set deviceconfig system hostname PA-NGFW-CORE-01
set deviceconfig system domain corp.paloaltonetworks.local
set deviceconfig system timezone US/Pacific

# --- Layer 3 Network Interfaces ---
set network interface ethernet ethernet1/1 layer3 ip 203.0.113.1/24
set network interface ethernet ethernet1/1 layer3 comment "Uplink to Public Transit / ISP-1"
set network interface ethernet ethernet1/2 layer3 ip 192.168.10.1/24
set network interface ethernet ethernet1/2 layer3 comment "DMZ Inbound Web Application Tier"
set network interface ethernet ethernet1/3 layer3 ip 10.100.1.1/24
set network interface ethernet ethernet1/3 layer3 comment "Trust Internal Corporate & App Tier"
set network interface ethernet ethernet1/4 layer3 ip 192.168.99.1/24
set network interface ethernet ethernet1/4 layer3 comment "Legacy QA & Test Staging Subnet"
set network interface ethernet ethernet1/8 layer3 ip 10.254.1.1/24
set network interface ethernet ethernet1/8 layer3 comment "Dedicated Out-of-Band Management"

# --- Virtual Router & Routing Table ---
set network virtual-router default interface [ ethernet1/1 ethernet1/2 ethernet1/3 ethernet1/4 ethernet1/8 ]
set network virtual-router default routing-table ip static-route "Default-Internet-Gateway" nexthop ip-address 203.0.113.254 interface ethernet1/1 metric 10 destination 0.0.0.0/0
set network virtual-router default routing-table ip static-route "Route-DMZ" interface ethernet1/2 destination 192.168.10.0/24
set network virtual-router default routing-table ip static-route "Route-Trust-Internal" interface ethernet1/3 destination 10.100.1.0/24
set network virtual-router default routing-table ip static-route "Route-Legacy-Test" interface ethernet1/4 destination 192.168.99.0/24

# --- Security Zones ---
set zone Untrust network layer3 ethernet1/1
set zone DMZ network layer3 ethernet1/2
set zone Trust-Internal network layer3 ethernet1/3
set zone Legacy-Test network layer3 ethernet1/4
set zone Management network layer3 ethernet1/8

# --- Address Objects & Groups ---
set address OBJ_NET_DMZ ip-netmask 192.168.10.0/24 description "DMZ Web Subnet"
set address OBJ_NET_TRUST ip-netmask 10.100.1.0/24 description "Internal Core Subnet"
set address OBJ_NET_LEGACY ip-netmask 192.168.99.0/24 description "Legacy QA Subnet"
set address OBJ_HOST_WEB_SRV01 ip-netmask 192.168.10.80/32 description "Production NGINX Reverse Proxy"
set address OBJ_HOST_API_PROXY02 ip-netmask 192.168.10.85/32 description "API Gateway Ingress"
set address OBJ_HOST_APP_SRV01 ip-netmask 10.100.1.20/32 description "Core Application Server"
set address OBJ_HOST_DB_SRV01 ip-netmask 10.100.1.50/32 description "Production PostgreSQL Database"
set address OBJ_HOST_MGMT_BASTION ip-netmask 10.254.1.10/32 description "Engineering SSH Bastion"

# --- NAT Policy Rules ---
# Inbound Destination NAT for Web Server
set rulebase nat rules "DNAT-Inbound-HTTPS" from Untrust to Untrust destination 203.0.113.80 service service-https destination-translation translated-address 192.168.10.80
# Outbound Dynamic IP and Port (DIPP) Source NAT
set rulebase nat rules "SNAT-Outbound-Trust" from Trust-Internal to Untrust source OBJ_NET_TRUST to-interface ethernet1/1 source-translation dynamic-ip-and-port interface-address interface ethernet1/1
set rulebase nat rules "SNAT-Outbound-DMZ" from DMZ to Untrust source OBJ_NET_DMZ to-interface ethernet1/1 source-translation dynamic-ip-and-port interface-address interface ethernet1/1

# --- Security Policy Rules (App-ID Driven) ---
# Rule 1: Allow public internet to access DMZ web servers with App-ID ssl & web-browsing
set rulebase security rules "Allow-Inbound-Web" from Untrust to DMZ source any destination OBJ_HOST_WEB_SRV01 application [ web-browsing ssl ] service application-default action allow description "Permit public HTTPS/HTTP to DMZ Web Server"

# Rule 2: Allow DMZ web server to call internal core app server REST APIs
set rulebase security rules "Allow-DMZ-to-App" from DMZ to Trust-Internal source OBJ_HOST_WEB_SRV01 destination OBJ_HOST_APP_SRV01 application [ web-browsing ssl ] service application-default action allow description "Permit DMZ microservice proxying to App Server"

# Rule 3: Allow Internal App Server to connect to Database
set rulebase security rules "Allow-App-to-DB" from Trust-Internal to Trust-Internal source OBJ_HOST_APP_SRV01 destination OBJ_HOST_DB_SRV01 application [ postgresql ] service application-default action allow description "Permit App to DB SQL queries"

# Rule 4: Strict Drop for any direct attempt from DMZ to DB
set rulebase security rules "Deny-DMZ-to-DB" from DMZ to Trust-Internal source OBJ_NET_DMZ destination OBJ_HOST_DB_SRV01 application any action drop description "Zero Trust: Strict block DMZ lateral movement to DB"

# Rule 5: Block external scanners trying SSH / Telnet / RDP
set rulebase security rules "Block-Untrust-Scanners" from Untrust to any source any destination any application [ ssh telnet ms-rdp ] action drop description "Mitigate unauthorized administrative access probes"

# Rule 6: Legacy testbed communication
set rulebase security rules "Allow-Legacy-Staging" from Legacy-Test to Trust-Internal source OBJ_NET_LEGACY destination OBJ_NET_TRUST application any action allow description "Temporary QA staging access"

# --- Operational Dump: show arp all ---
# interface         ip address        hw address        status   ttl
# ethernet1/1       203.0.113.254     00:50:56:a1:10:01 c        1190 (ISP Gateway)
# ethernet1/2       192.168.10.80     00:50:56:a1:10:80 c        1180 (OBJ_HOST_WEB_SRV01)
# ethernet1/2       192.168.10.85     00:50:56:a1:10:85 c        1175 (OBJ_HOST_API_PROXY02)
# ethernet1/3       10.100.1.20       00:50:56:a1:20:20 c        1150 (OBJ_HOST_APP_SRV01)
# ethernet1/3       10.100.1.50       00:50:56:a1:20:50 c        1140 (OBJ_HOST_DB_SRV01)
# ethernet1/4       192.168.99.44     00:50:56:a1:99:44 c        1020 (QA-Node-Alpha)
# ethernet1/8       10.254.1.10       00:50:56:a1:00:10 c        1200 (OBJ_HOST_MGMT_BASTION)
